# ---- 基座模型 ----
# 训练机基座模型路径（须含 config.json）
BASE_MODEL_PATH=/your/base llm/model path

# ---- 推理时使用的合并后模型 ----
MERGED_MODEL_PATH=./finetune/base-model-finetuned

# ---- 数据 ----
RAW_DATA_DIR=./中文医疗数据集
PROCESSED_DATA_DIR=./data/processed

# ---- 训练参数 ----
N_PER_DEPT=20000
# 训练数据构建：ask+answer 总字符上限（仅作用于 python run.py data，与推理生成无关）
MAX_CHAR_LEN=8192
SEED=42

# ---- OpenAI API + Web 聊天界面（src/modelServer.py，python run.py serve）----
# 同一端口同时提供 OpenAI 格式接口（/v1）与聊天网页（/）
API_HOST=0.0.0.0
API_PORT=8118
# 对外暴露的模型名（客户端 request.model 填这个名字）
SERVED_MODEL_NAME=your-model-name
# 思考模式默认开关（客户端可用 enable_thinking / chat_template_kwargs 按请求覆盖）
ENABLE_THINKING=false

# ---- 生成参数 ----
# 服务端默认值（同时作用于 web 聊天与 OpenAI API）；客户端请求显式传参时覆盖
# Qwen3 关闭思考模式的官方推荐采样: temperature=0.7 / top_p=0.8 / top_k=20
# 模型单次回复的最大生成 token 数（后端日志里的 max_new_tokens 就是它）
MAX_NEW_TOKENS=8192
TEMPERATURE=0.7
TOP_P=0.8
TOP_K=20
REPETITION_PENALTY=1.1

